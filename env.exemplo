# Copie para .env (chmod 600). Nunca versionar o .env.
MCP_PUBLIC_HOST=mcp-firecrawl.oryonntech.com
# Login por pessoa (Keycloak do auth-ecosan, realm mcp). Papel exigido: firecrawl-leitura.
OAUTH_EMISSOR=https://auth-ecosan.oryonntech.com/realms/mcp
OAUTH_PAPEL=firecrawl-leitura
# Token fixo opcional (>= 32 caracteres), para teste da esteira. Gerado pelo instalar.sh.
MCP_ACCESS_TOKEN=
